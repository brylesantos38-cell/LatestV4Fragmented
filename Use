    local function toggleMenu()
        isOpen = not isOpen
        if isOpen then
            mainFrame.Visible = true
            TweenService:Create(mainFrame, t_Info, {Position = pos_Visible}):Play()
        else
            local c_Tween = TweenService:Create(mainFrame, t_Info, {Position = pos_Hidden})
            c_Tween:Play()
            c_Tween.Completed:Connect(function()
                if not isOpen then mainFrame.Visible = false end
            end)
        end
    end

