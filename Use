local function s_Load(targetUrl)
    local success, result = pcall(function() return game:HttpGet(targetUrl) end)
    if success and result and not result:match("404: Not Found") then
        local run, err = loadstring(result)
        if run then 
            task.spawn(run) 
        else
            warn("[Fragmented Mode] Error loading script syntax: " .. tostring(err))
        end
    else
        warn("[Fragmented Mode] Failed to fetch URL: " .. tostring(targetUrl))
    end
end

local function AddCorner(guiElement, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 6)
    corner.Parent = guiElement
end

local function rollChance(percent)
    return math.random(1, 100) <= percent
end

local function MakeDraggable(frame, handle)
    handle = handle or frame
    local dragging, dragInput, dragStart, startPos

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end

local function IsSeekActive()
    local currentRooms = workspace:FindFirstChild("CurrentRooms")
    if not currentRooms then return false end

    local namesToCheck = {"Seek", "SeekMoving", "SeekMovingNewClone", "SeekEntity", "SeekDoor"}
    for _, name in ipairs(namesToCheck) do
        if workspace:FindFirstChild(name, true) or currentRooms:FindFirstChild(name, true) then
            return true
        end
    end

    for _, inst in ipairs(workspace:GetDescendants()) do
        if string.find(string.lower(inst.Name), "seek") then
            return true
        end
    end
    return false
end

