local function ReplaceAudGit(GithubSnd, SoundName) 
    local url = GithubSnd 
    if writefile and (getcustomasset or getsynasset) then
        if not isfile(SoundName..".mp3") then 
            writefile(SoundName..".mp3", game:HttpGet(url)) 
        end 
        return (getcustomasset or getsynasset)(SoundName..".mp3") 
    end
    return url
end 

-- Helper function to local-cache and format pitch settings on runtime sounds
local function PlayCustomSound(soundLink, volume, playbackSpeed, soundName, filename, pitchOctave)
    local sound = Instance.new("Sound")
    sound.SoundId = ReplaceAudGit(soundLink, filename)
    sound.Parent = workspace
    sound.Volume = volume
    sound.PlaybackSpeed = playbackSpeed
    sound.Name = soundName
    
    if pitchOctave then
        local pitchShift = Instance.new("PitchShiftSoundEffect")
        pitchShift.Octave = pitchOctave
        pitchShift.Parent = sound
    end
    
    sound:Play()
    return sound
end

